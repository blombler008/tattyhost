{
  "name": "tattyhost",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig ./tsconfig.json ./server.ts",
    "dev:mon": "nodemon",
    "build": "npm run build:client && npm run build:lib && npm run build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:lib": "npm run build:sqlutils && npm run build:cryptoutils",
    "build:sqlutils": "tsc --project tsconfig.sqlutils.json",
    "build:cryptoutils": "tsc --project tsconfig.cryptoutils.json",
    "preview": "cross-env NODE_ENV=production tsx ./server.ts",
    "lint": "eslint .",
    "test:ui": "cross-env TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test tests/button.test.tsx",
    "test:whitelist": "node --import tsx --test tests/whitelist-contract.test.ts",
    "test:services": "node --import tsx --test tests/service-status-contract.test.ts tests/whitelist-contract.test.ts tests/thn-contract.test.ts tests/player-lookup.test.ts",
    "test:settings": "node --experimental-test-module-mocks --import tsx --test tests/account-settings.test.ts tests/login-ip.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "mariadb": "^3.4.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sirv": "^3.0.1",
    "tailwindcss": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.1": true
  }
}
